PORT=3000
DATABASE_URL="postgresql://user:password@localhost:5432/mobpae"

JWT_SECRET=your-jwt-secret-here
JWT_EXPIRES_IN=7d

# Email (Brevo / any SMTP)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
SMTP_SECURE=false
MAIL_FROM=support@mobpae.com
MAIL_FROM_NAME=MobPae

# App
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
ENABLE_SWAGGER=true

# ─────────────────────────────────────────────
# Cloudflare R2 (Private File Storage)
# Bucket is PRIVATE — no public URLs are ever exposed.
# Files are served via short-lived signed URLs generated on demand.
# Get credentials: Cloudflare Dashboard → R2 → Manage R2 API Tokens
# ─────────────────────────────────────────────
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=mobpae-assets
