generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

enum Role {
  ADMIN
  EMPLOYER
  EMPLOYEE
}

enum EmployerStatus {
  PENDING
  APPROVED
  REJECTED
  ACTIVE
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
}

enum SalaryRequestStatus {
  SUBMITTED
  EMPLOYER_APPROVED
  EMPLOYER_REJECTED
  READY_FOR_DISBURSAL
  DISBURSED
  REPAYMENT_SCHEDULED
  REPAID
}

enum DisbursalStatus {
  PENDING
  DISBURSED
  FAILED
}

enum RepaymentStatus {
  SCHEDULED
  PAID
  OVERDUE
}

enum KycStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum EmployerEnquiryStatus {
  NEW
  CONTACTED
  APPROVED
  REJECTED
}

enum KycDocumentType {
  AADHAR
  PAN
  SALARY_SLIP
  OTHER
}

enum NotificationType {
  SYSTEM
  EMAIL
  SMS
}

model User {
  id          String   @id @default(uuid())
  email       String   @unique
  password    String
  role        Role
  isActive    Boolean  @default(true)
  lastLogin   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  employee    Employee?
  @@map("users")
}

model Employer {
  id                String           @id @default(uuid())
  companyName       String
  companyCode       String           @unique
  contactPerson     String
  email             String
  phone             String
  payrollDate       Int
  payrollCutoffDate Int
  status            EmployerStatus
  employees         Employee[]
  salaryRequests    SalaryRequest[]
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  @@map("employers")
}

model Employee {
  id              String          @id @default(uuid())
  userId          String?         @unique
  employerId      String
  employeeCode    String
  name            String
  email           String
  phone           String
  salaryInHand    Decimal         @db.Decimal(12,2)
  joiningDate     DateTime?
  status          EmployeeStatus  @default(ACTIVE)
  user            User?           @relation(fields: [userId], references: [id])
  employer        Employer        @relation(fields: [employerId], references: [id])
  salaryLimit     SalaryLimit?
  salaryRequests  SalaryRequest[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  @@unique([employerId, employeeCode])
  @@map("employees")
}