// ============================================================
// MobPae Backend — Prisma Schema v4.0
// Product-Based Lending Platform
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// CORE USER MODEL
// ============================================================

model User {
  id              String               @id @default(uuid())
  email           String               @unique
  password        String
  role            Role
  isActive        Boolean              @default(true)
  passwordChanged Boolean              @default(false)
  lastLogin       DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  auditLogs       AuditLog[]
  employee        Employee?
  employer        Employer?
  notifications   Notification[]
  passwordResets  PasswordResetToken[]
  sessions        UserSession[]

  @@map("users")
}

// ============================================================
// EMPLOYER
// ============================================================

model Employer {
  id                     String                  @id @default(uuid())
  companyName            String
  companyCode            String                  @unique
  contactPerson          String
  email                  String                  @unique
  phone                  String
  // Payroll calendar (day-of-month integers, e.g. payrollDate=28, cutoffDate=21)
  payrollDate            Int
  payrollCutoffDate      Int
  cycleType              PayrollCycleType        @default(MONTHLY)
  status                 EmployerStatus          @default(PENDING)
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  userId                 String                  @unique
  riskStatus             EmployerRiskStatus      @default(GOOD)
  employees              Employee[]
  employerEnquiry        EmployerEnquiry?
  settlements            EmployerSettlement[]
  user                   User                    @relation(fields: [userId], references: [id])
  loanApplications       LoanApplication[]
  employerProductConfigs EmployerProductConfig[]
  loanApplicationFees    LoanApplicationFee[]

  @@map("employers")
}

// ============================================================
// EMPLOYEE
// ============================================================

model Employee {
  id                  String               @id @default(uuid())
  userId              String?              @unique
  employerId          String
  employeeCode        String
  name                String
  email               String
  phone               String
  salaryInHand        Decimal              @db.Decimal(12, 2)
  profilePhotoUrl     String?
  selfieUrl           String?
  selfieStatus        SelfieStatus         @default(PENDING)
  selfieVerifiedAt    DateTime?
  selfieVerifiedBy    String?
  joiningDate         DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  appActivated        Boolean              @default(false)
  employmentStatus    EmployeeStatus       @default(ACTIVE)
  bankAccount         EmployeeBankAccount?
  employer            Employer             @relation(fields: [employerId], references: [id])
  user                User?                @relation(fields: [userId], references: [id])
  kycDocuments        KycDocument[]
  membership          Membership?
  loanLimit           LoanLimit?
  loanApplications    LoanApplication[]
  paymentOrders       PaymentOrder[]
  loanApplicationFees LoanApplicationFee[]

  @@unique([employerId, employeeCode])
  @@index([employerId])
  @@index([selfieStatus])
  @@map("employees")
}

// ============================================================
// EMPLOYEE BANK ACCOUNT
// ============================================================

model EmployeeBankAccount {
  id                String   @id @default(uuid())
  employeeId        String   @unique
  accountHolderName String
  accountNumber     String
  ifscCode          String
  bankName          String?
  upiId             String?
  verified          Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  employee          Employee @relation(fields: [employeeId], references: [id])

  @@index([verified])
  @@map("employee_bank_accounts")
}

// ============================================================
// LOAN PRODUCT CATALOG
// Metadata only — business rules live in LoanProductConfig.
// Each product type (SA, PL, etc.) has exactly one row here.
// ============================================================

model LoanProduct {
  id               String                  @id @default(uuid())
  productType      LoanProductType         @unique
  displayName      String
  description      String?
  icon             String? // Icon name / URL for employee app
  displayOrder     Int                     @default(0)
  isActive         Boolean                 @default(true)
  comingSoon       Boolean                 @default(false)
  launchDate       DateTime?
  retirementDate   DateTime?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  configs          LoanProductConfig[]
  loanApplications LoanApplication[]
  employerConfigs  EmployerProductConfig[]
  membershipPlans  MembershipPlanConfig[]

  @@map("loan_products")
}

// ============================================================
// VERSIONED PRODUCT CONFIGURATION
// Immutable once active. New version always creates a new row.
// previousVersionId forms a singly-linked version chain.
// ============================================================

model LoanProductConfig {
  id            String    @id @default(uuid())
  productId     String
  versionNumber Int
  versionName   String?
  isActive      Boolean   @default(false)
  effectiveFrom DateTime
  effectiveTo   DateTime?

  // Self-referential: points to the version this supersedes.
  // @unique ensures at most one successor per version.
  previousVersionId String? @unique

  // EligibilityRules — parsed by EligibilityService
  // Shape: { maximumAdvancePercentage, minimumAdvanceAmount,
  //          minimumSalaryInHand, minimumTenureMonths,
  //          requiresKyc, requiresMembership, requiresBankAccount,
  //          requiresActiveSelfie, maxRequestsPerCycle, cooldownDays }
  eligibilityRules Json

  // PricingRules — consumed by PricingService (pure function, no I/O)
  // Shape: { annualInterestRate, interestFreePercentage,
  //          processingFeeRate, gstRate }
  pricingRules Json

  // OperationalRules — consumed by LoanApplicationsService
  // Shape: { requiresEmployerApproval, requiresAdminApproval,
  //          minDisbursalDays, maxDisbursalDays, defaultFundingSource }
  operationalRules Json

  createdBy String?
  createdAt DateTime @default(now())

  product          LoanProduct        @relation(fields: [productId], references: [id])
  previousVersion  LoanProductConfig? @relation("ConfigVersionChain", fields: [previousVersionId], references: [id])
  nextVersion      LoanProductConfig? @relation("ConfigVersionChain")
  loanApplications LoanApplication[]

  @@unique([productId, versionNumber])
  @@index([productId, isActive])
  @@map("loan_product_configs")
}

// ============================================================
// EMPLOYER PRODUCT CONFIG (per-employer overrides + feature flags)
// Controls which products an employer enables and any overrides.
// ============================================================

model EmployerProductConfig {
  id                               String      @id @default(uuid())
  employerId                       String
  productId                        String
  // Absolute ₹ cap (set by admin for special cases)
  maximumAdvanceAmountOverride     Int?
  // % of salary override set by employer (e.g. 20 = 20%). Must be ≤ hardCeilingPercentage.
  maximumAdvancePercentageOverride Decimal?    @db.Decimal(5, 2)
  requiresEmployerApproval         Boolean     @default(true)
  isEnabled                        Boolean     @default(true)
  createdAt                        DateTime    @default(now())
  updatedAt                        DateTime    @updatedAt
  employer                         Employer    @relation(fields: [employerId], references: [id])
  product                          LoanProduct @relation(fields: [productId], references: [id])

  @@unique([employerId, productId])
  @@map("employer_product_configs")
}

// ============================================================
// LOAN LIMIT (replaces SalaryLimit)
// Set by Admin after KYC verification. One per employee.
// ============================================================

model LoanLimit {
  id                    String   @id @default(uuid())
  employeeId            String   @unique
  maximumEligibleAmount Decimal  @db.Decimal(12, 2)
  maxRequestsPerCycle   Int      @default(1)
  cooldownDays          Int      @default(0)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  employee              Employee @relation(fields: [employeeId], references: [id])

  @@map("loan_limits")
}

// ============================================================
// FUNDING PARTNER
// NULL fundingPartnerId on LoanApplication = MobPae self-funded.
// Add NBFC / bank partners here when ready.
// ============================================================

model FundingPartner {
  id               String               @id @default(uuid())
  name             String
  code             String               @unique // e.g. MOBPAE_SELF, HDFC_NBFC
  type             FundingPartnerType
  status           FundingPartnerStatus @default(ACTIVE)
  contactEmail     String?
  contactPhone     String?
  agreementDate    DateTime?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  loanApplications LoanApplication[]

  @@map("funding_partners")
}

// ============================================================
// LOAN APPLICATION (replaces SalaryRequest)
// ============================================================

model LoanApplication {
  id String @id @default(uuid())

  // Human-readable reference: MP-SA-2026-00001234
  applicationNumber String @unique

  employeeId    String
  employerId    String
  productId     String
  // Frozen config version at submission time — never updated
  configId      String
  // Version number copied from LoanProductConfig for easy reporting
  configVersion Int?

  // Optional funding partner (NULL = MobPae self-funded)
  fundingPartnerId String?

  // Three distinct amounts representing three decision points
  requestedAmount        Decimal  @db.Decimal(12, 2)
  employerApprovedAmount Decimal? @db.Decimal(12, 2)
  adminApprovedAmount    Decimal? @db.Decimal(12, 2)

  // Loan purpose
  purposeCategory LoanPurposeCategory
  purposeNote     String?

  // Status and timestamps
  status      LoanApplicationStatus @default(SUBMITTED)
  submittedAt DateTime              @default(now())

  // ── SNAPSHOT (frozen at submission time) ──────────────────
  // Rates from active LoanProductConfig.pricingRules at submission
  snapshotAnnualInterestRate        Decimal                   @db.Decimal(5, 2)
  snapshotInterestCalculationMethod InterestCalculationMethod @default(SIMPLE_DAILY)
  // Absolute ₹ threshold: min(salary × platformAdvancePercentage%, platformMaxAdvanceAmount)
  snapshotInterestFreeThreshold     Decimal                   @default(0) @db.Decimal(12, 2)
  snapshotProcessingFeeRate         Decimal                   @default(0) @db.Decimal(5, 4)
  snapshotGstRate                   Decimal                   @default(0) @db.Decimal(5, 4)
  // Effective advance % used (after employer override is applied)
  snapshotMaxAdvancePercentage      Decimal                   @db.Decimal(5, 2)
  // Employee facts at the moment of submission
  snapshotSalaryInHand              Decimal                   @db.Decimal(12, 2)
  // Pre-computed from employer's payroll dates — deterministic, frozen here
  snapshotInterestDays              Int
  snapshotRecoveryDate              DateTime
  // First day of the payroll cycle month this advance will be recovered in (e.g. 2026-07-01)
  snapshotPayrollCycle              DateTime?
  // ─────────────────────────────────────────────────────────

  // Approval tracking
  employerApprovedBy String?
  employerApprovedAt DateTime?
  adminApprovedBy    String?
  adminApprovedAt    DateTime?
  rejectedBy         String?
  rejectedAt         DateTime?
  rejectionReason    String?
  remarks            String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee       Employee                 @relation(fields: [employeeId], references: [id])
  employer       Employer                 @relation(fields: [employerId], references: [id])
  product        LoanProduct              @relation(fields: [productId], references: [id])
  config         LoanProductConfig        @relation(fields: [configId], references: [id])
  fundingPartner FundingPartner?          @relation(fields: [fundingPartnerId], references: [id])
  history        LoanApplicationHistory[]
  disbursal      Disbursal?
  repayment      Repayment?
  platformFee    LoanApplicationFee?

  @@index([employeeId])
  @@index([employerId])
  @@index([status])
  @@index([productId])
  @@index([submittedAt])
  @@map("loan_applications")
}

// ============================================================
// LOAN APPLICATION HISTORY
// ============================================================

model LoanApplicationHistory {
  id                String                 @id @default(uuid())
  loanApplicationId String
  previousStatus    LoanApplicationStatus?
  newStatus         LoanApplicationStatus
  changedBy         String?
  actorRole         String?
  remarks           String?
  createdAt         DateTime               @default(now())
  loanApplication   LoanApplication        @relation(fields: [loanApplicationId], references: [id])

  @@index([loanApplicationId, createdAt])
  @@index([newStatus])
  @@map("loan_application_history")
}

// ============================================================
// DISBURSAL
// Tracks the payout lifecycle from initiation to completion.
// Bank account details are frozen here at disbursal time so
// we always know where money was sent, even if employee later
// changes their bank account.
// ============================================================

model Disbursal {
  id                String @id @default(uuid())
  loanApplicationId String @unique

  // Three-stage amounts
  requestedAmount Decimal  @db.Decimal(12, 2)
  approvedAmount  Decimal  @db.Decimal(12, 2)
  disbursedAmount Decimal? @db.Decimal(12, 2)

  // Payment provider details
  paymentProvider     DisbursalProvider?
  providerReference   String? // Payout ID from provider (e.g. Razorpay pout_xxx)
  providerStatus      String? // Raw status string from provider
  providerRawResponse Json? // Full provider response for debugging

  // Bank account snapshot — frozen at disbursal time
  disbursalAccountNumber     String?
  disbursalIfscCode          String?
  disbursalBankName          String?
  disbursalAccountHolderName String?

  // Lifecycle
  status        DisbursalStatus @default(PENDING)
  failureReason String?
  retryCount    Int             @default(0)
  initiatedAt   DateTime?
  completedAt   DateTime?

  // People
  initiatedBy String? // Admin who triggered the payout
  disbursedBy String? // Can be system or different admin on retry

  remarks String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  loanApplication LoanApplication @relation(fields: [loanApplicationId], references: [id])

  @@index([status])
  @@map("disbursals")
}

// ============================================================
// REPAYMENT
// Amounts are computed at disbursal time using snapshot rates.
// Linked to SettlementLineItem (not directly to EmployerSettlement)
// once included in a settlement.
// ============================================================

model Repayment {
  id                String          @id @default(uuid())
  loanApplicationId String          @unique
  dueDate           DateTime
  paidDate          DateTime?
  status            RepaymentStatus @default(SCHEDULED)
  remarks           String?

  // Final computed amounts (calculated at disbursal with snapshot rates)
  principalAmount       Decimal @db.Decimal(12, 2)
  interestFreeAmount    Decimal @default(0) @db.Decimal(12, 2)
  interestBearingAmount Decimal @default(0) @db.Decimal(12, 2)
  interestAmount        Decimal @default(0) @db.Decimal(12, 2)
  processingFee         Decimal @default(0) @db.Decimal(12, 2)
  gstAmount             Decimal @default(0) @db.Decimal(12, 2)
  totalAmount           Decimal @db.Decimal(12, 2)

  // Frozen rates (makes repayment self-contained for display)
  interestRate Decimal @default(36) @db.Decimal(5, 2)
  interestDays Int     @default(0)

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  loanApplication LoanApplication @relation(fields: [loanApplicationId], references: [id])

  // Reverse relation — FK lives on SettlementLineItem
  settlementLineItem SettlementLineItem?

  @@index([status])
  @@index([dueDate])
  @@index([status, dueDate])
  @@map("repayments")
}

// ============================================================
// EMPLOYER SETTLEMENT
// One settlement per employer per payroll cycle.
// All amounts are frozen at generation time (snapshot pattern).
// ============================================================

model EmployerSettlement {
  id               String   @id @default(uuid())
  employerId       String
  // Human-readable: MPS-LTIM-202607-0001
  settlementNumber String   @unique
  // First day of the payroll recovery month (e.g. 2026-07-01)
  cycleDate        DateTime

  // Snapshot amounts — frozen at generation, never recalculated
  principalAmount     Decimal @db.Decimal(12, 2)
  interestAmount      Decimal @default(0) @db.Decimal(12, 2)
  processingFeeAmount Decimal @default(0) @db.Decimal(12, 2)
  gstAmount           Decimal @default(0) @db.Decimal(12, 2)
  lateFeeAmount       Decimal @default(0) @db.Decimal(12, 2)
  totalAmount         Decimal @db.Decimal(12, 2)
  // Decremented as payments are received
  outstandingAmount   Decimal @db.Decimal(12, 2)
  // Number of employees included in this settlement
  employeeCount       Int     @default(0)

  // Generation metadata
  generatedAt DateTime?
  generatedBy String?

  dueDate  DateTime
  paidDate DateTime?
  status   EmployerSettlementStatus @default(DRAFT)
  notes    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employer  Employer             @relation(fields: [employerId], references: [id])
  lineItems SettlementLineItem[]
  payments  SettlementPayment[]

  @@unique([employerId, cycleDate])
  @@index([employerId])
  @@index([status])
  @@map("employer_settlements")
}

// ============================================================
// SETTLEMENT LINE ITEM
// Invoice-line pattern: one row per employee per settlement.
// All fields are frozen snapshots — never recalculated.
// ============================================================

model SettlementLineItem {
  id                String @id @default(uuid())
  settlementId      String
  repaymentId       String @unique // 1-to-1: each repayment in at most one settlement
  loanApplicationId String
  employeeId        String

  // Frozen employee / application identifiers for display & export
  employeeCode          String
  employeeName          String
  loanApplicationNumber String

  // Frozen amounts
  principalAmount      Decimal @db.Decimal(12, 2)
  interestAmount       Decimal @default(0) @db.Decimal(12, 2)
  processingFee        Decimal @default(0) @db.Decimal(12, 2)
  gstAmount            Decimal @default(0) @db.Decimal(12, 2)
  totalDeductionAmount Decimal @db.Decimal(12, 2)

  status            SettlementLineItemStatus @default(INCLUDED)
  remarks           String?
  snapshotCreatedAt DateTime                 @default(now())

  settlement EmployerSettlement @relation(fields: [settlementId], references: [id])
  repayment  Repayment          @relation(fields: [repaymentId], references: [id])

  @@index([settlementId])
  @@map("settlement_line_items")
}

// ============================================================
// SETTLEMENT PAYMENT
// Tracks actual money received against a settlement.
// One settlement can have multiple payments (partial payments).
// ============================================================

model SettlementPayment {
  id               String                  @id @default(uuid())
  settlementId     String
  amount           Decimal                 @db.Decimal(12, 2)
  paymentMethod    SettlementPaymentMethod
  // Internal reference (MobPae-assigned)
  paymentReference String?
  // Bank UTR / NEFT reference from employer
  bankReference    String?
  transactionDate  DateTime
  receivedDate     DateTime?
  verifiedBy       String?
  verifiedAt       DateTime?
  status           SettlementPaymentStatus @default(PENDING)
  remarks          String?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  settlement EmployerSettlement @relation(fields: [settlementId], references: [id])

  @@index([settlementId])
  @@map("settlement_payments")
}

// ============================================================
// MEMBERSHIP
// ============================================================

model Membership {
  id             String           @id @default(uuid())
  employeeId     String           @unique
  planKey        String           @map("plan_key")
  planType       String           @default("MONTHLY") @map("plan_type")
  planName       String
  amount         Decimal          @db.Decimal(12, 2)
  amountPaid     Decimal?         @map("amount_paid") @db.Decimal(12, 2)
  startDate      DateTime
  endDate        DateTime
  status         MembershipStatus @default(PENDING)
  couponCode     String?          @map("coupon_code")
  discountAmount Decimal?         @map("discount_amount") @db.Decimal(12, 2)
  // Payment link — null for admin-created memberships
  paymentOrderId String?          @unique @map("payment_order_id")
  // Admin override fields
  verifiedBy     String?          @map("verified_by")
  verifiedAt     DateTime?        @map("verified_at")
  remarks        String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  employee       Employee         @relation(fields: [employeeId], references: [id])
  paymentOrder   PaymentOrder?    @relation(fields: [paymentOrderId], references: [id])

  @@index([status])
  @@index([endDate])
  @@map("memberships")
}

// ============================================================
// MEMBERSHIP PLAN CONFIG
// ============================================================

model MembershipPlanConfig {
  id            String         @id @default(uuid())
  productId     String         @map("product_id")
  planKey       String         @unique @map("plan_key")
  planName      String         @map("plan_name")
  amount        Decimal        @db.Decimal(12, 2)
  validityDays  Int            @map("validity_days")
  billingLabel  String         @map("billing_label")
  perMonthLabel String?        @map("per_month_label")
  isPreferred   Boolean        @default(false) @map("is_preferred")
  isActive      Boolean        @default(true) @map("is_active")
  sortOrder     Int            @default(0) @map("sort_order")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  product       LoanProduct    @relation(fields: [productId], references: [id])
  paymentOrders PaymentOrder[]

  @@map("membership_plan_configs")
}

// ============================================================
// MEMBERSHIP COUPON
// ============================================================

model MembershipCoupon {
  id             String    @id @default(uuid())
  code           String    @unique
  discountAmount Decimal   @db.Decimal(12, 2)
  isActive       Boolean   @default(true)
  validTill      DateTime?
  usageLimit     Int?
  usedCount      Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@map("membership_coupons")
}

// ============================================================
// EMPLOYER ENQUIRY
// ============================================================

model EmployerEnquiry {
  id            String                @id @default(uuid())
  companyName   String
  contactPerson String
  email         String
  phone         String
  employeeCount Int?
  status        EmployerEnquiryStatus @default(NEW)
  remarks       String?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  employerId    String?               @unique
  employer      Employer?             @relation(fields: [employerId], references: [id])

  @@index([status])
  @@index([createdAt])
  @@map("employer_enquiries")
}

// ============================================================
// KYC DOCUMENT
// ============================================================

model KycDocument {
  id               String          @id @default(uuid())
  employeeId       String
  documentType     KycDocumentType
  filePath         String
  originalFileName String?
  status           KycStatus       @default(PENDING)
  rejectionNote    String?
  verifiedBy       String?
  verifiedAt       DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  employee         Employee        @relation(fields: [employeeId], references: [id])

  @@unique([employeeId, documentType])
  @@index([status])
  @@index([status, employeeId])
  @@map("kyc_documents")
}

// ============================================================
// SETTINGS
// ============================================================

model Setting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("settings")
}

// ============================================================
// APP INFORMATION
// ============================================================

model AppInformation {
  id        String      @id @default(uuid())
  type      AppInfoType
  title     String
  content   String      @db.Text
  version   String?
  isActive  Boolean     @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@unique([type])
  @@index([type, isActive])
  @@map("app_information")
}

// ============================================================
// NOTIFICATION
// ============================================================

model Notification {
  id        String           @id @default(uuid())
  userId    String
  title     String
  message   String
  type      NotificationType @default(SYSTEM)
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id])

  @@index([userId, isRead])
  @@index([createdAt])
  @@map("notifications")
}

// ============================================================
// AUDIT LOG
// ============================================================

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  action     String
  entityType String
  entityId   String
  oldValue   Json?
  newValue   Json?
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id])

  @@index([createdAt])
  @@index([action])
  @@index([entityType])
  @@index([userId])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

// ============================================================
// USER SESSION
// ============================================================

model UserSession {
  id           String   @id @default(uuid())
  userId       String
  refreshToken String
  deviceInfo   String?
  ipAddress    String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([isActive])
  @@index([isActive, updatedAt])
  @@map("user_sessions")
}

// ============================================================
// PASSWORD RESET TOKEN
// ============================================================

model PasswordResetToken {
  id            String    @id @default(uuid())
  userId        String
  tokenHash     String
  expiresAt     DateTime
  usedAt        DateTime?
  createdAt     DateTime  @default(now())
  tokenSelector String?   @unique
  user          User      @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

// ============================================================
// PAYMENTS (Razorpay — membership collection)
// ============================================================

model PaymentOrder {
  id                   String                @id @default(uuid())
  provider             PaymentProvider       @default(RAZORPAY)
  providerOrderId      String                @unique @map("provider_order_id")
  amount               Int // in paise (INR × 100)
  currency             String                @default("INR")
  employeeId           String                @map("employee_id")
  purpose              PaymentOrderPurpose   @default(MEMBERSHIP)
  planKey              String?               @map("plan_key")
  loanApplicationFeeId String?               @map("loan_application_fee_id")
  couponCode           String?               @map("coupon_code")
  discountAmount       Int                   @default(0) @map("discount_amount")
  status               PaymentOrderStatus    @default(CREATED)
  notes                Json?
  expiresAt            DateTime              @map("expires_at")
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")
  employee             Employee              @relation(fields: [employeeId], references: [id])
  plan                 MembershipPlanConfig? @relation(fields: [planKey], references: [planKey])
  platformFee          LoanApplicationFee?   @relation(fields: [loanApplicationFeeId], references: [id])
  membership           Membership?
  events               PaymentEvent[]

  @@index([employeeId])
  @@index([status])
  @@index([purpose, status])
  @@index([providerOrderId])
  @@index([loanApplicationFeeId])
  @@map("payment_orders")
}

// Request-scoped commercial charge for salary advances.
// This intentionally lives outside Membership so future products can keep
// their own pricing models without coupling them to salary-advance approval.
model LoanApplicationFee {
  id                String                   @id @default(uuid())
  loanApplicationId String                   @unique @map("loan_application_id")
  employeeId        String                   @map("employee_id")
  employerId        String                   @map("employer_id")
  feeType           LoanApplicationFeeType   @default(PLATFORM_FEE) @map("fee_type")
  amount            Decimal                  @db.Decimal(12, 2)
  currency          String                   @default("INR")
  status            LoanApplicationFeeStatus @default(PENDING_PAYMENT)
  provider          PaymentProvider?         @default(RAZORPAY)
  providerOrderId   String?                  @map("provider_order_id")
  providerPaymentId String?                  @map("provider_payment_id")
  providerSignature String?                  @map("provider_signature")
  paidAt            DateTime?                @map("paid_at")
  waivedAt          DateTime?                @map("waived_at")
  waivedBy          String?                  @map("waived_by")
  remarks           String?
  createdAt         DateTime                 @default(now()) @map("created_at")
  updatedAt         DateTime                 @updatedAt @map("updated_at")

  loanApplication LoanApplication @relation(fields: [loanApplicationId], references: [id])
  employee        Employee        @relation(fields: [employeeId], references: [id])
  employer        Employer        @relation(fields: [employerId], references: [id])
  paymentOrders   PaymentOrder[]

  @@unique([loanApplicationId, feeType])
  @@index([employeeId, status])
  @@index([employerId, status])
  @@index([status, createdAt])
  @@index([providerOrderId])
  @@map("loan_application_fees")
}

model PaymentEvent {
  id                String       @id @default(uuid())
  orderId           String       @map("order_id")
  providerPaymentId String?      @map("provider_payment_id")
  providerSignature String?      @map("provider_signature")
  eventType         String       @map("event_type")
  source            String
  status            String
  method            String?
  errorCode         String?      @map("error_code")
  errorDescription  String?      @map("error_description")
  rawPayload        Json?        @map("raw_payload")
  capturedAt        DateTime?    @map("captured_at")
  createdAt         DateTime     @default(now()) @map("created_at")
  order             PaymentOrder @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@index([providerPaymentId])
  @@map("payment_events")
}

