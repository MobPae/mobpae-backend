generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  EMPLOYER
  EMPLOYEE
}

enum EmployerStatus {
  PENDING
  APPROVED
  REJECTED
  ACTIVE
  SUSPENDED
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
}

enum SalaryRequestStatus {
  SUBMITTED
  EMPLOYER_APPROVED
  EMPLOYER_REJECTED
  READY_FOR_DISBURSAL
  DISBURSED
  REPAYMENT_SCHEDULED
  REPAID
}

enum DisbursalStatus {
  PENDING
  DISBURSED
  FAILED
}

enum RepaymentStatus {
  SCHEDULED
  PAID
  OVERDUE
}

enum EmployerSettlementStatus {
  PENDING
  PARTIALLY_PAID
  PAID
  OVERDUE
}

enum EmployerRiskStatus {
  GOOD
  WARNING
  BLOCKED
}

enum MembershipStatus {
  PENDING
  ACTIVE
  REJECTED
  EXPIRED
  CANCELLED
}

enum KycStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum EmployerEnquiryStatus {
  NEW
  ONBOARDED
}

enum KycDocumentType {
  AADHAR
  PAN
  SALARY_SLIP
  OTHER
}

enum NotificationType {
  SYSTEM
  EMAIL
  SMS
}

model User {
  id       String  @id @default(uuid())
  email    String  @unique
  password String
  role     Role
  isActive Boolean @default(true)

  employer Employer?
  employee Employee?

  notifications  Notification[]
  auditLogs      AuditLog[]
  sessions       UserSession[]
  passwordResets PasswordResetToken[]

  lastLogin DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  passwordChanged Boolean @default(false)

  @@map("users")
}

model Employer {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  companyName       String
  companyCode       String @unique
  contactPerson     String
  email             String @unique
  phone             String
  payrollDate       Int
  payrollCutoffDate Int

  status EmployerStatus @default(PENDING)

  employees       Employee[]
  salaryRequests  SalaryRequest[]
  employerEnquiry EmployerEnquiry?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  riskStatus EmployerRiskStatus @default(GOOD)

  settlements EmployerSettlement[]

  @@map("employers")
}

model Employee {
  id             String               @id @default(uuid())
  userId         String?              @unique
  employerId     String
  employeeCode   String
  name           String
  email          String
  phone          String
  salaryInHand   Decimal              @db.Decimal(12, 2)
  joiningDate    DateTime?
  user           User?                @relation(fields: [userId], references: [id])
  employer       Employer             @relation(fields: [employerId], references: [id])
  salaryLimit    SalaryLimit?
  bankAccount    EmployeeBankAccount?
  salaryRequests SalaryRequest[]
  kycDocuments   KycDocument[]
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  employmentStatus EmployeeStatus @default(ACTIVE)
  appActivated     Boolean        @default(false)

  membership Membership?

  @@unique([employerId, employeeCode])
  @@index([employerId])
  @@map("employees")
}

model EmployeeBankAccount {
  id                String   @id @default(uuid())
  employeeId        String   @unique
  accountHolderName String
  accountNumber     String
  ifscCode          String
  bankName          String?
  upiId             String?
  verified          Boolean  @default(false)
  employee          Employee @relation(fields: [employeeId], references: [id])
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("employee_bank_accounts")
}

model SalaryLimit {
  id                  String   @id @default(uuid())
  employeeId          String   @unique
  approvedLimit       Decimal  @db.Decimal(12, 2)
  maxRequestsPerCycle Int      @default(1)
  cooldownDays        Int      @default(0)
  employee            Employee @relation(fields: [employeeId], references: [id])
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@map("salary_limits")
}

model SalaryRequest {
  id             String              @id @default(uuid())
  employeeId     String
  employerId     String
  amount         Decimal             @db.Decimal(12, 2)
  approvedAmount Decimal?            @db.Decimal(12, 2)
  approvedBy     String?
  approvedAt     DateTime?
  reason         String?
  remarks        String?
  requestedAt    DateTime            @default(now())
  repaymentDate  DateTime?
  status         SalaryRequestStatus @default(SUBMITTED)
  employee       Employee            @relation(fields: [employeeId], references: [id])
  employer       Employer            @relation(fields: [employerId], references: [id])
  disbursal      Disbursal?
  repayment      Repayment?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([employeeId])
  @@index([employerId])
  @@index([status])
  @@map("salary_requests")
}

model Disbursal {
  id              String          @id @default(uuid())
  salaryRequestId String          @unique
  amount          Decimal         @db.Decimal(12, 2)
  disbursedBy     String?
  disbursedAt     DateTime?
  status          DisbursalStatus @default(PENDING)
  remarks         String?
  salaryRequest   SalaryRequest   @relation(fields: [salaryRequestId], references: [id])
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@map("disbursals")
}

model Repayment {
  id              String @id @default(uuid())
  salaryRequestId String @unique

  principalAmount Decimal @default(0) @db.Decimal(12, 2)
  totalAmount     Decimal @default(0) @db.Decimal(12, 2)

  interestAmount Decimal @default(0) @db.Decimal(12, 2)
  interestRate   Decimal @default(36) @db.Decimal(5, 2)
  interestDays   Int     @default(0)

  dueDate  DateTime
  paidDate DateTime?
  status   RepaymentStatus @default(SCHEDULED)
  remarks  String?

  salaryRequest SalaryRequest @relation(fields: [salaryRequestId], references: [id])
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@map("repayments")
}

model EmployerEnquiry {
  id            String                @id @default(uuid())
  employerId    String?               @unique
  companyName   String
  contactPerson String
  email         String
  phone         String
  employeeCount Int?
  status        EmployerEnquiryStatus @default(NEW)
  remarks       String?
  employer      Employer?             @relation(fields: [employerId], references: [id])
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  @@map("employer_enquiries")
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  title     String
  message   String
  type      NotificationType @default(SYSTEM)
  isRead    Boolean          @default(false)
  user      User             @relation(fields: [userId], references: [id])
  createdAt DateTime         @default(now())

  @@map("notifications")
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  action     String
  entityType String
  entityId   String
  oldValue   Json?
  newValue   Json?
  user       User?    @relation(fields: [userId], references: [id])
  createdAt  DateTime @default(now())

  @@map("audit_logs")
}

model UserSession {
  id           String   @id @default(uuid())
  userId       String
  refreshToken String
  deviceInfo   String?
  ipAddress    String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([isActive])
  @@map("user_sessions")
}

model PasswordResetToken {
  id            String    @id @default(uuid())
  userId        String
  tokenSelector String?   @unique
  tokenHash     String
  expiresAt     DateTime
  usedAt        DateTime?
  createdAt     DateTime  @default(now())
  user          User      @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model KycDocument {
  id           String          @id @default(uuid())
  employeeId   String
  documentType KycDocumentType
  filePath     String
  status       KycStatus       @default(PENDING)
  verifiedBy   String?
  verifiedAt   DateTime?
  employee     Employee        @relation(fields: [employeeId], references: [id])
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@map("kyc_documents")
}

model Setting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("settings")
}

model Membership {
  id                String           @id @default(uuid())
  employeeId        String           @unique
  planName          String
  amount            Decimal          @db.Decimal(12, 2)
  startDate         DateTime
  endDate           DateTime
  status            MembershipStatus @default(PENDING)
  paymentReference  String?
  paymentScreenshot String?
  verifiedBy        String?
  verifiedAt        DateTime?
  remarks           String?
  couponCode        String?
  discountAmount    Decimal?         @db.Decimal(12, 2)
  employee          Employee         @relation(fields: [employeeId], references: [id])
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@map("memberships")
}

model MembershipCoupon {
  id             String    @id @default(uuid())
  code           String    @unique
  discountAmount Decimal   @db.Decimal(12, 2)
  isActive       Boolean   @default(true)
  validTill      DateTime?
  usageLimit     Int?
  usedCount      Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@map("membership_coupons")
}

model EmployerSettlement {
  id String @id @default(uuid())

  employerId String

  payrollMonth String

  principalAmount Decimal @db.Decimal(12, 2)

  interestAmount Decimal @default(0) @db.Decimal(12, 2)

  lateFeeAmount Decimal @default(0) @db.Decimal(12, 2)

  totalAmount Decimal @db.Decimal(12, 2)

  outstandingAmount Decimal @db.Decimal(12, 2)

  dueDate DateTime

  paidDate DateTime?

  status EmployerSettlementStatus @default(PENDING)

  referenceNumber String?

  notes String?

  employer Employer @relation(fields: [employerId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([employerId, payrollMonth])
  @@index([employerId])
  @@index([status])
  @@map("employer_settlements")
}
