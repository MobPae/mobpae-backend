generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String               @id @default(uuid())
  email           String               @unique
  password        String
  role            Role
  isActive        Boolean              @default(true)
  passwordChanged Boolean              @default(false)
  lastLogin       DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  auditLogs       AuditLog[]
  employee        Employee?
  employer        Employer?
  notifications   Notification[]
  passwordResets  PasswordResetToken[]
  sessions        UserSession[]

  @@map("users")
}

model Employer {
  id                String               @id @default(uuid())
  companyName       String
  companyCode       String               @unique
  contactPerson     String
  email             String               @unique
  phone             String
  payrollDate       Int
  payrollCutoffDate Int
  status            EmployerStatus       @default(PENDING)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  userId            String               @unique
  riskStatus        EmployerRiskStatus   @default(GOOD)
  employees         Employee[]
  employerEnquiry   EmployerEnquiry?
  settlements       EmployerSettlement[]
  user              User                 @relation(fields: [userId], references: [id])
  salaryRequests    SalaryRequest[]

  @@map("employers")
}

model Employee {
  id               String               @id @default(uuid())
  userId           String?              @unique
  employerId       String
  employeeCode     String
  name             String
  email            String
  phone            String
  salaryInHand     Decimal              @db.Decimal(12, 2)
  profilePhotoUrl  String?
  selfieUrl        String?
  selfieStatus     SelfieStatus         @default(PENDING)
  selfieVerifiedAt DateTime?
  selfieVerifiedBy String?
  joiningDate      DateTime?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  appActivated     Boolean              @default(false)
  employmentStatus EmployeeStatus       @default(ACTIVE)
  bankAccount      EmployeeBankAccount?
  employer         Employer             @relation(fields: [employerId], references: [id])
  user             User?                @relation(fields: [userId], references: [id])
  kycDocuments     KycDocument[]
  membership       Membership?
  salaryLimit      SalaryLimit?
  salaryRequests   SalaryRequest[]

  @@unique([employerId, employeeCode])
  @@index([employerId])
  @@index([selfieStatus])
  @@map("employees")
}

model EmployeeBankAccount {
  id                String   @id @default(uuid())
  employeeId        String   @unique
  accountHolderName String
  accountNumber     String
  ifscCode          String
  bankName          String?
  upiId             String?
  verified          Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  employee          Employee @relation(fields: [employeeId], references: [id])

  @@index([verified])
  @@map("employee_bank_accounts")
}

model SalaryLimit {
  id                  String   @id @default(uuid())
  employeeId          String   @unique
  approvedLimit       Decimal  @db.Decimal(12, 2)
  maxRequestsPerCycle Int      @default(1)
  cooldownDays        Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  employee            Employee @relation(fields: [employeeId], references: [id])

  @@map("salary_limits")
}

model SalaryRequest {
  id             String              @id @default(uuid())
  employeeId     String
  employerId     String
  amount         Decimal             @db.Decimal(12, 2)
  approvedAmount Decimal?            @db.Decimal(12, 2)
  approvedBy     String?
  approvedAt     DateTime?
  reason         String?
  remarks        String?
  requestedAt    DateTime            @default(now())
  repaymentDate  DateTime?
  status         SalaryRequestStatus @default(SUBMITTED)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  disbursal      Disbursal?
  repayment      Repayment?
  employee       Employee            @relation(fields: [employeeId], references: [id])
  employer       Employer            @relation(fields: [employerId], references: [id])

  @@index([employeeId])
  @@index([employerId])
  @@index([status])
  @@map("salary_requests")
}

model Disbursal {
  id              String          @id @default(uuid())
  salaryRequestId String          @unique
  amount          Decimal         @db.Decimal(12, 2)
  disbursedBy     String?
  disbursedAt     DateTime?
  status          DisbursalStatus @default(PENDING)
  remarks         String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  salaryRequest   SalaryRequest   @relation(fields: [salaryRequestId], references: [id])

  @@map("disbursals")
}

model Repayment {
  id              String              @id @default(uuid())
  salaryRequestId String              @unique
  settlementId    String?
  dueDate         DateTime
  paidDate        DateTime?
  status          RepaymentStatus     @default(SCHEDULED)
  remarks         String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  interestAmount  Decimal             @default(0) @db.Decimal(12, 2)
  interestDays    Int                 @default(0)
  interestRate    Decimal             @default(36) @db.Decimal(5, 2)
  principalAmount Decimal             @default(0) @db.Decimal(12, 2)
  totalAmount     Decimal             @default(0) @db.Decimal(12, 2)
  salaryRequest   SalaryRequest       @relation(fields: [salaryRequestId], references: [id])
  settlement      EmployerSettlement? @relation(fields: [settlementId], references: [id])

  @@index([settlementId])
  @@index([status])
  @@index([dueDate])
  @@index([status, dueDate])
  @@map("repayments")
}

model EmployerEnquiry {
  id            String                @id @default(uuid())
  companyName   String
  contactPerson String
  email         String
  phone         String
  employeeCount Int?
  status        EmployerEnquiryStatus @default(NEW)
  remarks       String?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  employerId    String?               @unique
  employer      Employer?             @relation(fields: [employerId], references: [id])

  @@index([status])
  @@index([createdAt])
  @@map("employer_enquiries")
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  title     String
  message   String
  type      NotificationType @default(SYSTEM)
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id])

  @@index([userId, isRead])
  @@index([createdAt])
  @@map("notifications")
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  action     String
  entityType String
  entityId   String
  oldValue   Json?
  newValue   Json?
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id])

  @@index([createdAt])
  @@index([action])
  @@index([entityType])
  @@index([userId])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

model UserSession {
  id           String   @id @default(uuid())
  userId       String
  refreshToken String
  deviceInfo   String?
  ipAddress    String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([isActive])
  @@index([isActive, updatedAt])
  @@map("user_sessions")
}

model PasswordResetToken {
  id            String    @id @default(uuid())
  userId        String
  tokenHash     String
  expiresAt     DateTime
  usedAt        DateTime?
  createdAt     DateTime  @default(now())
  tokenSelector String?   @unique
  user          User      @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model KycDocument {
  id           String          @id @default(uuid())
  employeeId   String
  documentType KycDocumentType
  filePath     String
  status       KycStatus       @default(PENDING)
  verifiedBy   String?
  verifiedAt   DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  employee     Employee        @relation(fields: [employeeId], references: [id])

  @@unique([employeeId, documentType])
  @@index([status])
  @@index([status, employeeId])
  @@map("kyc_documents")
}

model Setting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("settings")
}

model Membership {
  id                String           @id @default(uuid())
  employeeId        String           @unique
  planName          String
  amount            Decimal          @db.Decimal(12, 2)
  startDate         DateTime
  endDate           DateTime
  status            MembershipStatus @default(PENDING)
  paymentReference  String?
  paymentScreenshot String?
  verifiedBy        String?
  verifiedAt        DateTime?
  remarks           String?
  couponCode        String?
  discountAmount    Decimal?         @db.Decimal(12, 2)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  employee          Employee         @relation(fields: [employeeId], references: [id])

  @@index([status])
  @@index([endDate])
  @@map("memberships")
}

model MembershipCoupon {
  id             String    @id @default(uuid())
  code           String    @unique
  discountAmount Decimal   @db.Decimal(12, 2)
  isActive       Boolean   @default(true)
  validTill      DateTime?
  usageLimit     Int?
  usedCount      Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@map("membership_coupons")
}

model EmployerSettlement {
  id                String                   @id @default(uuid())
  employerId        String
  payrollMonth      String
  principalAmount   Decimal                  @db.Decimal(12, 2)
  interestAmount    Decimal                  @default(0) @db.Decimal(12, 2)
  lateFeeAmount     Decimal                  @default(0) @db.Decimal(12, 2)
  totalAmount       Decimal                  @db.Decimal(12, 2)
  outstandingAmount Decimal                  @db.Decimal(12, 2)
  dueDate           DateTime
  paidDate          DateTime?
  status            EmployerSettlementStatus @default(PENDING)
  referenceNumber   String?
  notes             String?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  employer          Employer                 @relation(fields: [employerId], references: [id])
  repayments        Repayment[]

  @@unique([employerId, payrollMonth])
  @@index([employerId])
  @@index([status])
  @@map("employer_settlements")
}

enum Role {
  ADMIN
  EMPLOYER
  EMPLOYEE
}

enum EmployerStatus {
  PENDING
  APPROVED
  REJECTED
  ACTIVE
  SUSPENDED
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
}

enum SelfieStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum SalaryRequestStatus {
  SUBMITTED
  EMPLOYER_APPROVED
  EMPLOYER_REJECTED
  AWAITING_MEMBERSHIP_PAYMENT
  READY_FOR_DISBURSAL
  DISBURSED
  REPAYMENT_SCHEDULED
  REPAID
}

enum DisbursalStatus {
  PENDING
  DISBURSED
  FAILED
}

enum RepaymentStatus {
  SCHEDULED
  PAID
  OVERDUE
}

enum EmployerSettlementStatus {
  NO_DUES
  PENDING
  PARTIALLY_PAID
  PAID
  OVERDUE
}

enum EmployerRiskStatus {
  GOOD
  WARNING
  BLOCKED
}

enum MembershipStatus {
  PENDING
  ACTIVE
  REJECTED
  EXPIRED
  CANCELLED
}

enum KycStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum EmployerEnquiryStatus {
  NEW
  CONTACTED
  REJECTED
  ONBOARDED
}

enum KycDocumentType {
  AADHAR
  PAN
  SALARY_SLIP
  OTHER
}

enum NotificationType {
  SYSTEM
  EMAIL
  SMS
}

model AppInformation {
  id        String      @id @default(uuid())
  type      AppInfoType
  title     String
  content   String      @db.Text
  version   String?
  isActive  Boolean     @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@unique([type])
  @@index([type, isActive])
  @@map("app_information")
}

enum AppInfoType {
  ABOUT
  PRIVACY_POLICY
  TERMS_CONDITIONS
  HOW_IT_WORKS
  FAQ
  CONTACT
  WHATS_NEW
}
